# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sintesis?schema=public"

# Administrador inicial (se crea con `npm run db:seed`). Contraseña de 12+ caracteres.
ADMIN_EMAIL="admin@sintesis.local"
ADMIN_PASSWORD="cambia-esta-contrasena-larga"

# URL pública (enlaces de recuperación y de «Compartir PDF»).
APP_URL="http://localhost:3000"

# Límite de tamaño por archivo (MB). La interfaz debe usar el mismo valor.
MAX_UPLOAD_MB=25
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Operaciones pesadas simultáneas (LibreOffice, OCR, Chromium…).
SINTESIS_MAX_JOBS=2

# Motores (ver scripts/setup-engines.sh). Por defecto, rutas del entorno de desarrollo.
SINTESIS_PYTHON="/opt/sintesis-venv/bin/python"
SINTESIS_OCRMYPDF="/opt/sintesis-venv/bin/ocrmypdf"
# CHROMIUM_PATH="/opt/pw-browsers/chromium"

# Carpeta de archivos compartidos por enlace (caducan solos).
# SINTESIS_STORAGE_DIR="./storage"

# Servicios de IA y voz: opcionales. Sin ellos, esas herramientas muestran «requiere configuración».
# ANTHROPIC_API_KEY="sk-ant-..."
# SINTESIS_AI_MODEL="claude-sonnet-5-5"
# SINTESIS_STT_API_KEY="sk-..."          # transcripción de audio (API compatible con OpenAI)
# SINTESIS_STT_URL="https://api.openai.com/v1/audio/transcriptions"
# SINTESIS_STT_MODEL="whisper-1"

# Correo: sin proveedor, los mensajes de recuperación se escriben en la consola del servidor.
# MAIL_DRIVER="console"
