# Copia este archivo a .env y ajusta los valores.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kitdigital?schema=public"

# Cuenta de administrador inicial (se crea con `npm run db:seed`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia-esta-contrasena-larga"

# Límite de tamaño por archivo subido (MB).
MAX_UPLOAD_MB=25

# URL pública de la aplicación (usada en enlaces de recuperación de contraseña).
APP_URL="http://localhost:3000"
